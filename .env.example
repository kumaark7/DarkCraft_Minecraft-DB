VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=/api/v1
# Player-facing IP or DNS host (no port), used when Minecraft binds to all interfaces.
VITE_MINECRAFT_PUBLIC_HOST=

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_READ_ONLY=true
DASHBOARD_DATA_DIR=.data
MINECRAFT_SERVERS_ROOT=.data/servers
DASHBOARD_ALLOWED_ORIGINS=https://darkcraft.projectdarkhope.xyz
DASHBOARD_SECURE_COOKIES=true
DASHBOARD_CONSOLE_LOG_MAX_MB=10
DASHBOARD_CONSOLE_LOG_RETENTION_FILES=5
